# FastAPI settings. Save as /opt/anywayone/backend.env on the server.
APP_ENV=production

DATABASE_HOST=host.docker.internal
DATABASE_PORT=5432
DATABASE_NAME=anywayone_blog
DATABASE_USER=anywayone
DATABASE_PASSWORD=replace-with-a-strong-database-password
DATABASE_SSL_MODE=disable
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5

SECRET_KEY=replace-with-at-least-32-random-characters
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
CORS_ORIGINS=https://www.anywayone.com,https://admin.anywayone.com
COOKIE_SECURE=true

MEDIA_STORAGE_BACKEND=local
MEDIA_STORAGE_PATH=/data/media
MEDIA_PUBLIC_URL=https://api.anywayone.com/media
MEDIA_MAX_UPLOAD_BYTES=10485760

# Cloudflare R2 (set MEDIA_STORAGE_BACKEND=r2 and use the public bucket/custom domain URL)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
